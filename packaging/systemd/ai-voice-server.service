[Unit]
Description=AI Voice Server (Whisper Dictation Pipeline)
After=network.target

[Service]
Type=simple
User=aivoice
Group=aivoice
SupplementaryGroups=video render
ExecStartPre=-/usr/bin/nvidia-modprobe -u -c 0
EnvironmentFile=-/etc/conf.d/ai-voice-server
ExecStart=/usr/bin/ai-voice-server
Restart=on-failure
RestartSec=5
RestartForceExitStatus=42

# Sandbox / Security Hardening (Gentoo best practice)
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
# Allow access to GPU devices (explicit device nodes + char types)
DeviceAllow=/dev/nvidia0 rwm
DeviceAllow=/dev/nvidia1 rwm
DeviceAllow=/dev/nvidia2 rwm
DeviceAllow=/dev/nvidia3 rwm
DeviceAllow=/dev/nvidiactl rwm
DeviceAllow=/dev/nvidia-uvm rwm
DeviceAllow=/dev/nvidia-uvm-tools rwm
DeviceAllow=/dev/nvidia-modeset rwm
DeviceAllow=/dev/dri/renderD128 rwm
DeviceAllow=char-nvidia rwm
DeviceAllow=char-nvidia-uvm rwm

[Install]
WantedBy=multi-user.target
