[Unit]
Description=AI Voice Server (Whisper Dictation Pipeline)
After=network.target

[Service]
Type=simple
User=aivoice
Group=aivoice
SupplementaryGroups=video render
ExecStartPre=-/usr/bin/nvidia-modprobe -u -c 0
EnvironmentFile=-/etc/conf.d/ai-voice-server
ExecStart=/usr/bin/ai-voice-server
Restart=on-failure
RestartSec=5

# Sandbox / Security Hardening (Gentoo best practice)
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
# Allow access to GPU devices
DeviceAllow=/dev/nvidia* rwm
DeviceAllow=/dev/nvidiactl rwm
DeviceAllow=/dev/nvidia-uvm rwm
DeviceAllow=/dev/nvidia-uvm-tools rwm
DeviceAllow=/dev/dri/renderD128 rwm

[Install]
WantedBy=multi-user.target
